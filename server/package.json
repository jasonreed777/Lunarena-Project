{
  "name": "@gamenite/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "tsc",
    "lint": "eslint .",
    "prettier": "prettier --ignore-path ../.gitignore --check . ",
    "prettier:fix": "prettier --ignore-path ../.gitignore --write .",
    "test": "vitest run --coverage",
    "dev": "nodemon --watch src --exec node ./src/server.ts",
    "start": "MODE=production node ./src/server.ts",
    "vitest": "vitest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@better-auth/core": "^1.5.5",
    "@better-auth/mongo-adapter": "^1.5.5",
    "@better-auth/utils": "^0.3.1",
    "@better-fetch/fetch": "^1.1.21",
    "@gamenite/shared": "^1.0.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "better-auth": "^1.5.5",
    "better-call": "^1.3.2",
    "defu": "^6.1.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "mongodb": "^7.1.0",
    "mongoose": "^8.15.0",
    "nanostores": "^1.1.1",
    "socket.io": "^4.8.1",
    "zod": "^4.3.6"
  }
}
